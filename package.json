{
  "name": "mistral-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Minimal full-stack chat app using the official Mistral AI TypeScript SDK with streaming",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server/index.js"
  },
  "dependencies": {
    "@mistralai/mistralai": "^3.5.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
